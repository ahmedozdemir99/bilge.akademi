rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ahmedkadiri99@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidIsoDate(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function ownsClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function ownsStudent(studentId) {
      return exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.teacherId == request.auth.uid;
    }

    // --- Validation Blueprints (Pure static validation, zero DB reads) ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'schoolName', 'branch', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        data.role in ['student', 'teacher', 'admin'] &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 120)) &&
        (!('branch' in data) || (data.branch is string && data.branch.size() <= 80)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateContact(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'updatedAt']) &&
        data.ownerId == userId &&
        isValidId(data.ownerId) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['ownerId', 'theme', 'workspaceView', 'compactMode', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'theme', 'workspaceView', 'compactMode', 'updatedAt']) &&
        data.ownerId == userId &&
        isValidId(data.ownerId) &&
        data.theme in ['light', 'dark'] &&
        data.workspaceView in ['teacher', 'student'] &&
        data.compactMode is bool &&
        data.updatedAt is timestamp;
    }

    function isValidSchoolClass(data) {
      return data.keys().hasAll(['teacherId', 'name', 'gradeLevel', 'section', 'academicYear', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['teacherId', 'name', 'gradeLevel', 'section', 'academicYear', 'subjectFocus', 'createdAt', 'updatedAt']) &&
        data.teacherId == request.auth.uid &&
        isValidId(data.teacherId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        data.gradeLevel is int && data.gradeLevel >= 1 && data.gradeLevel <= 12 &&
        data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
        data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20 &&
        (!('subjectFocus' in data) || (data.subjectFocus is string && data.subjectFocus.size() <= 80)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['teacherId', 'classId', 'fullName', 'studentNumber', 'gradeLevel', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['teacherId', 'classId', 'fullName', 'studentNumber', 'gradeLevel', 'guardianNote', 'status', 'createdAt', 'updatedAt']) &&
        data.teacherId == request.auth.uid &&
        isValidId(data.teacherId) &&
        isValidId(data.classId) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        data.studentNumber is string && data.studentNumber.size() >= 1 && data.studentNumber.size() <= 24 &&
        data.gradeLevel is int && data.gradeLevel >= 1 && data.gradeLevel <= 12 &&
        (!('guardianNote' in data) || (data.guardianNote is string && data.guardianNote.size() <= 400)) &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['teacherId', 'name', 'code', 'createdAt']) &&
        data.keys().hasOnly(['teacherId', 'name', 'code', 'createdAt']) &&
        data.teacherId == request.auth.uid &&
        isValidId(data.teacherId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 16 &&
        data.createdAt is timestamp;
    }

    function isValidExam(data) {
      return data.keys().hasAll(['teacherId', 'classId', 'subjectName', 'title', 'examType', 'examDate', 'maxScore', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['teacherId', 'classId', 'subjectName', 'title', 'examType', 'examDate', 'maxScore', 'createdAt', 'updatedAt']) &&
        data.teacherId == request.auth.uid &&
        isValidId(data.teacherId) &&
        isValidId(data.classId) &&
        data.subjectName is string && data.subjectName.size() >= 2 && data.subjectName.size() <= 80 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.examType in ['Yazılı', 'Deneme', 'Sözlü', 'Proje', 'Performans'] &&
        isValidIsoDate(data.examDate) &&
        data.maxScore is number && data.maxScore >= 1 && data.maxScore <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGrade(data) {
      return data.keys().hasAll(['teacherId', 'studentId', 'classId', 'subjectName', 'examTitle', 'examType', 'examDate', 'score', 'maxScore', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['teacherId', 'studentId', 'classId', 'subjectName', 'examTitle', 'examType', 'examDate', 'score', 'maxScore', 'teacherNote', 'createdAt', 'updatedAt']) &&
        data.teacherId == request.auth.uid &&
        isValidId(data.teacherId) &&
        isValidId(data.studentId) &&
        isValidId(data.classId) &&
        data.subjectName is string && data.subjectName.size() >= 2 && data.subjectName.size() <= 80 &&
        data.examTitle is string && data.examTitle.size() >= 2 && data.examTitle.size() <= 120 &&
        data.examType in ['Yazılı', 'Deneme', 'Sözlü', 'Proje', 'Performans'] &&
        isValidIsoDate(data.examDate) &&
        data.score is number && data.score >= 0 && data.score <= data.maxScore &&
        data.maxScore is number && data.maxScore >= 1 && data.maxScore <= 100 &&
        (!('teacherNote' in data) || (data.teacherNote is string && data.teacherNote.size() <= 300)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['teacherId', 'studentId', 'classId', 'date', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['teacherId', 'studentId', 'classId', 'date', 'status', 'reason', 'createdAt', 'updatedAt']) &&
        data.teacherId == request.auth.uid &&
        isValidId(data.teacherId) &&
        isValidId(data.studentId) &&
        isValidId(data.classId) &&
        isValidIsoDate(data.date) &&
        data.status in ['present', 'excused', 'unexcused', 'late'] &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 240)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubjectPair(d, y, maxQ) {
      return d is int && y is int && d >= 0 && y >= 0 && (d + y) <= maxQ;
    }

    function isValidPracticeExam(data) {
      return data.keys().hasAll([
          'teacherId', 'studentId', 'classId', 'examTitle', 'examDate', 'wrongPenalty',
          'turkceD', 'turkceY', 'matematikD', 'matematikY', 'fenD', 'fenY',
          'inkilapD', 'inkilapY', 'dinD', 'dinY', 'ingilizceD', 'ingilizceY',
          'totalCorrect', 'totalWrong', 'totalNet', 'estimatedLgsScore', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'teacherId', 'studentId', 'classId', 'examTitle', 'examDate', 'wrongPenalty',
          'turkceD', 'turkceY', 'matematikD', 'matematikY', 'fenD', 'fenY',
          'inkilapD', 'inkilapY', 'dinD', 'dinY', 'ingilizceD', 'ingilizceY',
          'totalCorrect', 'totalWrong', 'totalNet', 'estimatedLgsScore', 'createdAt', 'updatedAt'
        ]) &&
        data.teacherId == request.auth.uid &&
        isValidId(data.teacherId) &&
        isValidId(data.studentId) &&
        isValidId(data.classId) &&
        data.examTitle is string && data.examTitle.size() >= 2 && data.examTitle.size() <= 120 &&
        isValidIsoDate(data.examDate) &&
        data.wrongPenalty in [3, 4] &&
        isValidSubjectPair(data.turkceD, data.turkceY, 20) &&
        isValidSubjectPair(data.matematikD, data.matematikY, 20) &&
        isValidSubjectPair(data.fenD, data.fenY, 20) &&
        isValidSubjectPair(data.inkilapD, data.inkilapY, 10) &&
        isValidSubjectPair(data.dinD, data.dinY, 10) &&
        isValidSubjectPair(data.ingilizceD, data.ingilizceY, 10) &&
        data.totalCorrect is int && data.totalCorrect >= 0 && data.totalCorrect <= 90 &&
        data.totalWrong is int && data.totalWrong >= 0 && data.totalWrong <= 90 &&
        (data.totalCorrect + data.totalWrong) <= 90 &&
        data.totalNet is number && data.totalNet >= -30 && data.totalNet <= 90 &&
        data.estimatedLgsScore is number && data.estimatedLgsScore >= 100 && data.estimatedLgsScore <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPoem(data) {
      return data.keys().hasAll(['ownerId', 'title', 'genre', 'content', 'isDraft', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'title', 'genre', 'content', 'isDraft', 'createdAt', 'updatedAt']) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 50 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
        data.isDraft is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAIConversation(data) {
      return data.keys().hasAll(['ownerId', 'moduleContext', 'title', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'moduleContext', 'title', 'lastPrompt', 'lastResponse', 'createdAt', 'updatedAt']) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        data.moduleContext is string && data.moduleContext.size() >= 1 && data.moduleContext.size() <= 60 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        (!('lastPrompt' in data) || (data.lastPrompt is string && data.lastPrompt.size() <= 1000)) &&
        (!('lastResponse' in data) || (data.lastResponse is string && data.lastResponse.size() <= 4000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuizAttempt(data) {
      return data.keys().hasAll(['ownerId', 'moduleName', 'topic', 'score', 'totalQuestions', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'moduleName', 'topic', 'score', 'totalQuestions', 'createdAt']) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        data.moduleName in ['edebiyat', 'tarih', 'matematik', 'felsefe', 'fen', 'ingilizce', 'din'] &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 100 &&
        data.score is int && data.score >= 0 && data.score <= data.totalQuestions &&
        data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100 &&
        data.createdAt is timestamp;
    }

    function isValidMathAttempt(data) {
      return data.keys().hasAll(['ownerId', 'topic', 'difficulty', 'isCorrect', 'hintsUsed', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'topic', 'difficulty', 'isCorrect', 'hintsUsed', 'createdAt']) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.ownerId) &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 100 &&
        data.difficulty in ['kolay', 'orta', 'zor'] &&
        data.isCorrect is bool &&
        data.hintsUsed is int && data.hintsUsed >= 0 && data.hintsUsed <= 5 &&
        data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Admins
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    // Users (Owner-only profile; role cannot be self-escalated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'student' || isAdmin());
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'schoolName', 'branch', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'contact' &&
          isOwner(userId) &&
          isValidUserPrivateContact(incoming(), userId) &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          docId == 'contact' &&
          isValidUserPrivateContact(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && docId == 'contact' && (isOwner(userId) || isAdmin());
      }
    }

    // Deneme Analizi backup: isolated from /users profile validation.
    match /denemeArchives/{userId} {
      allow get: if isVerifiedUser() && isOwner(userId);
      allow list, delete: if false;
      allow create: if isVerifiedUser() && isOwner(userId) &&
        incoming().keys().hasAll(['ownerId', 'displayName', 'examCount', 'studentCount', 'lastBackupAt', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['ownerId', 'displayName', 'examCount', 'studentCount', 'lastBackupAt', 'createdAt', 'updatedAt']) &&
        incoming().ownerId == userId && incoming().displayName is string &&
        incoming().examCount is int && incoming().examCount >= 0 && incoming().examCount <= 500 &&
        incoming().studentCount is int && incoming().studentCount >= 0 && incoming().studentCount <= 5000 &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        incoming().lastBackupAt == request.time;
      allow update: if isVerifiedUser() && isOwner(userId) &&
        existing().ownerId == userId && incoming().ownerId == userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().keys().hasOnly(['ownerId', 'displayName', 'examCount', 'studentCount', 'lastBackupAt', 'createdAt', 'updatedAt']) &&
        incoming().displayName is string &&
        incoming().examCount is int && incoming().examCount >= 0 && incoming().examCount <= 500 &&
        incoming().studentCount is int && incoming().studentCount >= 0 && incoming().studentCount <= 5000 &&
        incoming().lastBackupAt == request.time && incoming().updatedAt == request.time;
      match /exams/{examId} {
        allow get, list: if isVerifiedUser() && isOwner(userId);
        allow create, update: if isVerifiedUser() && isOwner(userId) &&
          incoming().ownerId == userId && isValidId(examId) &&
          incoming().keys().hasAll(['id', 'ownerId', 'createdAt', 'updatedAt']) &&
          incoming().id == examId &&
          incoming().createdAt is timestamp && incoming().updatedAt == request.time &&
          (!exists(/databases/$(database)/documents/denemeArchives/$(userId)/exams/$(examId)) ||
            incoming().createdAt == existing().createdAt);
        allow delete: if false;
      }
      match /students/{studentId} {
        allow get, list: if isVerifiedUser() && isOwner(userId);
        allow create, update: if isVerifiedUser() && isOwner(userId) &&
          incoming().ownerId == userId && isValidId(studentId) &&
          incoming().keys().hasAll(['id', 'ownerId', 'createdAt', 'updatedAt']) &&
          incoming().id == studentId &&
          incoming().createdAt is timestamp && incoming().updatedAt == request.time &&
          (!exists(/databases/$(database)/documents/denemeArchives/$(userId)/students/$(studentId)) ||
            incoming().createdAt == existing().createdAt);
        allow delete: if false;
      }
    }

    // Private, immutable trial-archive snapshots.
    match /users/{userId}/trialBackups/{backupId} {
      allow get, list: if isVerifiedUser() && isOwner(userId);
      allow create: if isVerifiedUser() && isOwner(userId) &&
        backupId.matches('^[a-f0-9]{64}$') &&
        incoming().keys().hasOnly(['title', 'examDate', 'classCount', 'studentCount', 'chunkCount', 'createdAt']) &&
        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 120 &&
        isValidIsoDate(incoming().examDate) &&
        incoming().classCount is int && incoming().classCount >= 1 &&
        incoming().studentCount is int && incoming().studentCount >= 1 &&
        incoming().chunkCount is int && incoming().chunkCount >= 1 && incoming().chunkCount <= 56 &&
        incoming().createdAt == request.time;

      match /chunks/{chunkId} {
        allow get: if isVerifiedUser() && isOwner(userId);
        allow create: if isVerifiedUser() && isOwner(userId) &&
          backupId.matches('^[a-f0-9]{64}$') && chunkId.matches('^[0-9]{1,2}$') &&
          incoming().keys().hasOnly(['content']) &&
          incoming().content is string && incoming().content.size() >= 1 && incoming().content.size() <= 300000;
      }
    }

    // User Settings
    match /userSettings/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserSettings(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserSettings(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'workspaceView', 'compactMode', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Classes (Zero get/exists in list queries — Pillar 8 compliant)
    match /classes/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().teacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(classId) &&
        isValidSchoolClass(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(classId) &&
        isValidSchoolClass(incoming()) &&
        incoming().teacherId == existing().teacherId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().teacherId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'gradeLevel', 'section', 'academicYear', 'subjectFocus', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(classId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Students (Sensitive PII — strictly scoped to owning teacher)
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().teacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(studentId) &&
        isValidStudent(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ownsClass(incoming().classId);
      allow update: if isVerifiedUser() &&
        isValidId(studentId) &&
        isValidStudent(incoming()) &&
        incoming().teacherId == existing().teacherId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().teacherId == request.auth.uid &&
            ownsClass(incoming().classId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classId', 'fullName', 'studentNumber', 'gradeLevel', 'guardianNote', 'status', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(studentId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Subjects
    match /subjects/{subjectId} {
      allow get: if isSignedIn() && isValidId(subjectId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().teacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(subjectId) &&
        isValidSubject(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(subjectId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Exams
    match /exams/{examId} {
      allow get: if isSignedIn() && isValidId(examId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().teacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(examId) &&
        isValidExam(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ownsClass(incoming().classId);
      allow update: if isVerifiedUser() &&
        isValidId(examId) &&
        isValidExam(incoming()) &&
        incoming().teacherId == existing().teacherId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().teacherId == request.auth.uid &&
            ownsClass(incoming().classId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classId', 'subjectName', 'title', 'examType', 'examDate', 'maxScore', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(examId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Grades
    match /grades/{gradeId} {
      allow get: if isSignedIn() && isValidId(gradeId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().teacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(gradeId) &&
        isValidGrade(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ownsClass(incoming().classId) &&
        ownsStudent(incoming().studentId);
      allow update: if isVerifiedUser() &&
        isValidId(gradeId) &&
        isValidGrade(incoming()) &&
        incoming().teacherId == existing().teacherId &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().teacherId == request.auth.uid &&
            ownsClass(incoming().classId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classId', 'subjectName', 'examTitle', 'examType', 'examDate', 'score', 'maxScore', 'teacherNote', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(gradeId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && isValidId(attendanceId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().teacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(attendanceId) &&
        isValidAttendance(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ownsClass(incoming().classId) &&
        ownsStudent(incoming().studentId);
      allow update: if isVerifiedUser() &&
        isValidId(attendanceId) &&
        isValidAttendance(incoming()) &&
        incoming().teacherId == existing().teacherId &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().teacherId == request.auth.uid &&
            ownsClass(incoming().classId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['classId', 'date', 'status', 'reason', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(attendanceId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Practice Exams (Ortaokul / LGS Trial Exam Net Robot)
    match /practiceExams/{examRecordId} {
      allow get: if isSignedIn() && isValidId(examRecordId) && (existing().teacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().teacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(examRecordId) &&
        isValidPracticeExam(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        ownsClass(incoming().classId) &&
        ownsStudent(incoming().studentId);
      allow update: if isVerifiedUser() &&
        isValidId(examRecordId) &&
        isValidPracticeExam(incoming()) &&
        incoming().teacherId == existing().teacherId &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().teacherId == request.auth.uid &&
            ownsClass(incoming().classId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'classId', 'examTitle', 'examDate', 'wrongPenalty',
              'turkceD', 'turkceY', 'matematikD', 'matematikY', 'fenD', 'fenY',
              'inkilapD', 'inkilapY', 'dinD', 'dinY', 'ingilizceD', 'ingilizceY',
              'totalCorrect', 'totalWrong', 'totalNet', 'estimatedLgsScore', 'updatedAt'
            ]))
        );
      allow delete: if isVerifiedUser() && isValidId(examRecordId) && (existing().teacherId == request.auth.uid || isAdmin());
    }

    // Poems
    match /poems/{poemId} {
      allow get: if isSignedIn() && isValidId(poemId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(poemId) &&
        isValidPoem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(poemId) &&
        isValidPoem(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'genre', 'content', 'isDraft', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(poemId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // AI Conversations
    match /aiConversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(conversationId) &&
        isValidAIConversation(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(conversationId) &&
        isValidAIConversation(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastPrompt', 'lastResponse', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(conversationId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(attemptId) &&
        isValidQuizAttempt(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(attemptId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Math Attempts
    match /mathAttempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(attemptId) &&
        isValidMathAttempt(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(attemptId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
